# Server
NODE_ENV=production
PORT=8000
PUBLIC_API_URL=https://your-api.onrender.com
RESET_PASSWORD_BASE_URL=https://your-api.onrender.com
ALLOWED_ORIGINS=

# Database
# Neon free Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/student_job_platform?sslmode=require

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Email
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM=Student Job Platform <onboarding@resend.dev>
RESEND_REPLY_TO=support@example.com

# Optional SMTP fallback
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Student Job Platform Support <support@example.com>

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
