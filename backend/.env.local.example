# Local development configuration
NODE_ENV=development
PORT=5000
PUBLIC_API_URL=http://localhost:5000
RESET_PASSWORD_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080

# Local PostgreSQL installed on this computer.
DATABASE_URL=postgresql://student_job_platform:student_job_platform@127.0.0.1:5432/student_job_platform

# Development-only secret. Replace it if the machine is shared.
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRES_IN=7d

# Optional local file storage is used when these are empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email is optional for local development.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

EXPOSE_RESET_DEBUG_LINKS=true
